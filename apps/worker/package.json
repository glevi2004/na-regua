{
  "name": "@na-regua/worker",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "main": "./src/index.ts",
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=../../.env src/index.ts",
    "start": "tsx --env-file-if-exists=../../.env src/index.ts",
    "build": "tsc --noEmit",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --passWithNoTests",
    "clean": "rm -rf dist .turbo",
    "lint": "eslint src"
  },
  "dependencies": {
    "@na-regua/contracts": "workspace:*",
    "@na-regua/core": "workspace:*",
    "@na-regua/db": "workspace:*",
    "@na-regua/env": "workspace:*",
    "@na-regua/money": "workspace:*",
    "bullmq": "^5.34.6",
    "ioredis": "^5.4.2"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^3.2.6"
  }
}
